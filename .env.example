OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=32768
# Generation budget. Keep this smaller than OLLAMA_NUM_CTX so the prompt
# still fits. If both are equal, gemma4 thinking can fill the window and
# leave message.content empty (CrewAI then aborts).
OLLAMA_MAX_TOKENS=16384
# gemma4: keep false. true (think=False) discards thought tokens and often
# empties content instead of returning a usable answer.
# gemma4 では false のままにする。true だと思考トークンだけ生成して空応答になる
OLLAMA_DISABLE_THINKING=false
TAVILY_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json
GOOGLE_SHEETS_WORKSHEET=research_results
EVAL_QUALITY_THRESHOLD=0.6
FEEDBACK_ENABLED=true
FEEDBACK_UNKNOWN_CODE_THRESHOLD=2
FEEDBACK_LESSONS_MAX_CHARS=1500
