OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=32768
# Generation budget for answer + tool calls. gemma4 thinking can consume many
# tokens first; too-low values yield empty message.content and CrewAI aborts.
OLLAMA_MAX_TOKENS=16384
# gemma4: keep false. true (think=False) discards thought tokens and often
# empties content instead of returning a usable answer.
OLLAMA_DISABLE_THINKING=false
TAVILY_API_KEY=
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json
GOOGLE_SHEETS_WORKSHEET=research_results
EVAL_QUALITY_THRESHOLD=0.6
